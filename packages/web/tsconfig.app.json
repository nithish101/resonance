{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "@webgpu/types"]
  },
  "include": ["src"],
  "exclude": [
    "src/workers",
    "src/audio/worklet",
    "src/**/*.worker.ts",
    "src/wasm",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
